default_shell "fish"

theme "purple"
simplified_ui true
default_layout "compact"

keybinds {
    unbind "Ctrl p" "Ctrl n"
    normal {
        bind "Alt p" { SwitchToMode "Pane"; }
        bind "Alt n" { SwitchToMode "Resize"; }
    }
    pane {
        bind "Alt p" { SwitchToMode "Normal"; }
    }
    resize {
        bind "Alt n" { SwitchToMode "Normal"; }
   }
}

themes {
    purple {
        text_unselected {
            base 220 220 235
            background 15 15 20
            emphasis_0 185 150 255
            emphasis_1 160 110 255
            emphasis_2 140 80 220
            emphasis_3 200 130 255
        }
        text_selected {
            base 240 240 250
            background 60 40 90
            emphasis_0 185 150 255
            emphasis_1 160 110 255
            emphasis_2 140 80 220
            emphasis_3 200 130 255
        }
        ribbon_selected {
            base 15 15 20
            background 140 80 220
            emphasis_0 20 20 25
            emphasis_1 200 130 255
            emphasis_2 185 150 255
            emphasis_3 160 110 255
        }
        ribbon_unselected {
            base 20 20 25
            background 80 60 120
            emphasis_0 30 30 35
            emphasis_1 200 180 255
            emphasis_2 160 110 255
            emphasis_3 185 150 255
        }
        table_title {
            base 160 110 255
            background 15 15 20
            emphasis_0 200 130 255
            emphasis_1 140 80 220
            emphasis_2 110 70 180
            emphasis_3 185 150 255
        }
        table_cell_selected {
            base 240 240 250
            background 60 40 90
            emphasis_0 200 130 255
            emphasis_1 160 110 255
            emphasis_2 140 80 220
            emphasis_3 185 150 255
        }
        table_cell_unselected {
            base 230 230 240
            background 15 15 20
            emphasis_0 200 130 255
            emphasis_1 160 110 255
            emphasis_2 140 80 220
            emphasis_3 185 150 255
        }
        list_selected {
            base 240 240 250
            background 60 40 90
            emphasis_0 200 130 255
            emphasis_1 160 110 255
            emphasis_2 140 80 220
            emphasis_3 185 150 255
        }
        list_unselected {
            base 230 230 240
            background 15 15 20
            emphasis_0 200 130 255
            emphasis_1 160 110 255
            emphasis_2 140 80 220
            emphasis_3 185 150 255
        }
        frame_selected {
            base 140 80 220
            background 15 15 20
            emphasis_0 200 130 255
            emphasis_1 160 110 255
            emphasis_2 185 150 255
            emphasis_3 0
        }
        frame_highlight {
            base 200 130 255
            background 0
            emphasis_0 200 130 255
            emphasis_1 200 130 255
            emphasis_2 200 130 255
            emphasis_3 200 130 255
        }
        exit_code_success {
            base 140 80 220
            background 15 15 20
            emphasis_0 160 110 255
            emphasis_1 0 0 0
            emphasis_2 185 150 255
            emphasis_3 100 120 200
        }
        exit_code_error {
            base 30 0 0
            background 15 0 0
            emphasis_0 255 80 80
            emphasis_1 100 0 0
            emphasis_2 60 0 0
            emphasis_3 40 0 0
        }
        multiplayer_user_colors {
            player_1 185 150 255
            player_2 160 110 255
            player_3 120 90 200
            player_4 255 186 0
            player_5 140 80 220
            player_6 80 60 120
            player_7 50 40 80
            player_8 100 70 160
            player_9 200 130 255
            player_10 170 100 240
        }
    }
}

